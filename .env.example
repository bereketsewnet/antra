# ── Antra backend — environment template ──
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# Placement:
#   • local dev:  <project>/.env
#   • cPanel:     /home/USERNAME/.env  (OUTSIDE public_html — never web-readable)
#
# Note: SMTP credentials for outgoing email live in server/mail-config.php
# (shared with the existing contact form) — they are not part of this file.

# ── MySQL ──
DB_HOST=127.0.0.1
DB_NAME=antra_web
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── Sessions ──
SESSION_NAME=antra_admin_sess
# true in production (HTTPS), false for local http dev
COOKIE_SECURE=true

# ── Uploads ──
# Absolute path OUTSIDE public_html in production; empty = default server/private/cvs
UPLOAD_DIR=
MAX_UPLOAD_BYTES=5242880

# ── Email alerts for new job applications ──
# Recipient; empty = fall back to mail-config.php's to_email
HR_ALERT_EMAIL=
# true in production, false locally
SEND_ALERTS=true
